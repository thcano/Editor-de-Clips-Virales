# Configuración local del Editor de Clips Virales.
# Copia este archivo a `.env` y ajusta lo que necesites.
# El lanzador `viralclip` y la API cargan `.env` automáticamente.
# Las variables ya definidas en el entorno tienen prioridad sobre el archivo.

# --- Servidor ---------------------------------------------------------------
VIRALCLIP_ENV=development
VIRALCLIP_HOST=127.0.0.1
VIRALCLIP_PORT=8000
VIRALCLIP_LOG_LEVEL=INFO

# Orígenes permitidos por CORS (separados por comas).
VIRALCLIP_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Clave opcional para proteger /api/*. Si se define, envía X-API-Key.
# VIRALCLIP_API_KEY=

# --- Datos ------------------------------------------------------------------
VIRALCLIP_DB_PATH=data/viralclip.db
VIRALCLIP_MAX_INPUT_BYTES=2000000
VIRALCLIP_MAX_CLIPS=8
VIRALCLIP_MAX_SEGMENTS=20000

# --- Ollama (opcional) ------------------------------------------------------
VIRALCLIP_LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
VIRALCLIP_OLLAMA_TIMEOUT=60
VIRALCLIP_OLLAMA_HEALTH_TIMEOUT=2
VIRALCLIP_OLLAMA_CIRCUIT_FAILURES=3
VIRALCLIP_OLLAMA_CIRCUIT_COOLDOWN=60

# --- Transcripción local (Whisper) -----------------------------------------
# Modelo por defecto: small. Puedes elegir medium desde la interfaz.
VIRALCLIP_WHISPER_MODEL=small
VIRALCLIP_WHISPER_DEVICE=auto
VIRALCLIP_WHISPER_COMPUTE_TYPE=auto
VIRALCLIP_WHISPER_LANGUAGE=auto
# VIRALCLIP_WHISPER_MODEL_DIR=C:\Users\tu-usuario\AppData\Local\ViralClip\models
VIRALCLIP_WHISPER_BEAM_SIZE=5
VIRALCLIP_WHISPER_VAD=true

# --- Subidas y FFmpeg -------------------------------------------------------
VIRALCLIP_UPLOAD_MAX_BYTES=2000000000
# VIRALCLIP_UPLOAD_DIR=C:\Users\tu-usuario\AppData\Local\ViralClip\uploads
VIRALCLIP_FFMPEG=ffmpeg
VIRALCLIP_FFPROBE=ffprobe

# --- Renderizado vertical ---------------------------------------------------
# MP4 1080x1920, 30 fps, H.264 CRF 20 y AAC 192 kbps.
# VIRALCLIP_RENDER_DIR=C:\Users\tu-usuario\AppData\Local\ViralClip\renders
VIRALCLIP_RENDER_WIDTH=1080
VIRALCLIP_RENDER_HEIGHT=1920
VIRALCLIP_RENDER_FPS=30
VIRALCLIP_RENDER_CRF=20
VIRALCLIP_RENDER_PRESET=veryfast
VIRALCLIP_RENDER_ZOOM=0.06
VIRALCLIP_RENDER_FONT=Arial
VIRALCLIP_RENDER_FONT_SIZE=54
VIRALCLIP_RENDER_TIMEOUT=1800
