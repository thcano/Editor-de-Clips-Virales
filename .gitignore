# Artefactos de release: se publican como GitHub Releases, no dentro del repo.
# GitHub rechaza ficheros > 100 MB en un push.
dist/*.zip
dist/*.exe

# Credenciales y entorno local
.env
.env.local
*.local

# Modelos de Whisper y medios pesados generados en runtime
data/models/
data/uploads/
data/renders/

# Base de datos de ejecución (se regenera sola)
data/*.db
data/*.db-shm
data/*.db-wal

# Python
__pycache__/
# Solo bytecode compilado. NO usar "*.py[cod]": ese patrón también captura
# los ".pyd" (módulos de extensión nativos), que son binarios **necesarios**
# en el bundle del ejecutable (p.ej. _cffi_backend, requerido por clr_loader
# para arrancar la ventana nativa de pywebview).
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Artefactos de build y herramientas
build/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.fortify/

# IDE
.vscode/
.idea/
